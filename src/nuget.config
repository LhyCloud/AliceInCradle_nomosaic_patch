<!-- BepInEx.Core / HarmonyX 官方包发布在 BepInEx 自建 feed 上，nuget.org 上没有 -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="bepinex" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
</configuration>
